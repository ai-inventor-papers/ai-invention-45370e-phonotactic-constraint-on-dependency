\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Mean dependency distance (MDD) across word-order types. SVO languages ($n = 41$) averaged 3.07, SOV languages ($n = 11$) averaged 3.04, and VSO languages ($n = 3$) averaged 3.67. ANOVA: $F = 1.36$, $p = 0.27$. Excluding VSO: $F = 0.06$, $p = 0.81$, $\eta ^2 = 0.0005$. Word order does not predict MDD.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:fig2}{{2}{6}{Mean dependency distance (MDD) across word-order types. SVO languages ($n = 41$) averaged 3.07, SOV languages ($n = 11$) averaged 3.04, and VSO languages ($n = 3$) averaged 3.67. ANOVA: $F = 1.36$, $p = 0.27$. Excluding VSO: $F = 0.06$, $p = 0.81$, $\eta ^2 = 0.0005$. Word order does not predict MDD}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Scatter plot of phonological density (normalized phoneme inventory size) against mean dependency distance. Spearman $r = 0.19$, $p = 0.17$. OLS: $R^2 = 0.05$, slope = 1.48, intercept = 2.34. The positive slope runs opposite to the predicted direction. Mixed-effects model (family random intercept): $\beta = 0.84$, $p = 0.39$.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:fig3}{{3}{7}{Scatter plot of phonological density (normalized phoneme inventory size) against mean dependency distance. Spearman $r = 0.19$, $p = 0.17$. OLS: $R^2 = 0.05$, slope = 1.48, intercept = 2.34. The positive slope runs opposite to the predicted direction. Mixed-effects model (family random intercept): $\beta = 0.84$, $p = 0.39$}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Functional versus Lexical Dependencies}{8}{subsection.4.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}Family-Level Patterns}{8}{subsection.4.5}\protected@file@percent }
